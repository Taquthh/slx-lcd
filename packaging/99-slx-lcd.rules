# ID-Cooling SL360 XE LCD (Turing Rev C compatible).
# Sleeping state 1a86:ca21, awake state 0525:a4a7 (or serial 20080411, or 1d6b:0121/0106).
# "uaccess" gives the logged-in desktop user access without adding them to any group.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="ca21", TAG+="uaccess", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0525", ATTRS{idProduct}=="a4a7", TAG+="uaccess", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0121", TAG+="uaccess", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0106", TAG+="uaccess", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{serial}=="20080411", TAG+="uaccess", MODE="0660", GROUP="dialout"
