{
  "name": "Nebula Refined",
  "width": 480,
  "height": 480,
  "background": { "color": "#0B0914" },
  "widgets": [
    {
      "type": "clock",
      "x": 240,
      "y": 75,
      "format": "%H:%M",
      "size": 82,
      "bold": true,
      "align": "center",
      "color": "#FFFFFF"
    },
    {
      "type": "clock",
      "x": 240,
      "y": 140,
      "format": "%A, %d %B",
      "size": 20,
      "align": "center",
      "color": "#A09DB0"
    },

    {
      "type": "gauge",
      "cx": 135,
      "cy": 255,
      "r": 85,
      "value": "cpu.usage",
      "fg": "#00FFC4",
      "bg": "#211D33",
      "thickness": 22,
      "cap": "round"
    },
    {
      "type": "text",
      "x": 135,
      "y": 190,
      "text": "CPU",
      "size": 18,
      "bold": true,
      "align": "center",
      "color": "#A09DB0"
    },
    {
      "type": "text",
      "x": 135,
      "y": 250,
      "text": "{cpu.usage}%",
      "size": 40,
      "bold": true,
      "align": "center",
      "color": "#FFFFFF"
    },
    {
      "type": "text",
      "x": 135,
      "y": 315,
      "text": "{cpu.temp}°C",
      "size": 22,
      "bold": true,
      "align": "center",
      "color": "#00FFC4"
    },

    {
      "type": "gauge",
      "cx": 345,
      "cy": 255,
      "r": 85,
      "value": "gpu0.usage",
      "fg": "#FF2A6D",
      "bg": "#211D33",
      "thickness": 22,
      "cap": "round"
    },
    {
      "type": "text",
      "x": 345,
      "y": 190,
      "text": "GPU",
      "size": 18,
      "bold": true,
      "align": "center",
      "color": "#A09DB0"
    },
    {
      "type": "text",
      "x": 345,
      "y": 250,
      "text": "{gpu0.usage}%",
      "size": 40,
      "bold": true,
      "align": "center",
      "color": "#FFFFFF"
    },
    {
      "type": "text",
      "x": 345,
      "y": 315,
      "text": "{gpu0.temp}°C",
      "size": 22,
      "bold": true,
      "align": "center",
      "color": "#FF2A6D"
    },

    {
      "type": "text",
      "x": 80,
      "y": 365,
      "text": "RAM",
      "size": 18,
      "bold": true,
      "color": "#A09DB0"
    },
    {
      "type": "text",
      "x": 400,
      "y": 365,
      "text": "{mem.used_gb:.1} / {mem.total_gb:.0} GB",
      "size": 18,
      "bold": true,
      "align": "right",
      "color": "#FFFFFF"
    },
    {
      "type": "bar",
      "x": 80,
      "y": 385,
      "w": 320,
      "h": 18,
      "value": "mem.used",
      "fg": "#8A2BE2",
      "bg": "#211D33",
      "radius": 9
    },

    {
      "type": "text",
      "x": 240,
      "y": 420,
      "text": "↓ {net.down:rate}      ↑ {net.up:rate}",
      "size": 16,
      "bold": true,
      "align": "center",
      "color": "#E0D4FF"
    }
  ]
}
